# ==========================================
# PrepWiseAI - Vercel Environment Variables
# ==========================================

# 1. MongoDB Atlas Connection URI
# Sign up at https://www.mongodb.com/cloud/atlas (Free M0 cluster)
# Format: mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/prepwiseai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/prepwiseai?retryWrites=true&w=majority

# 2. JWT Authentication Secrets
JWT_SECRET=your_secure_random_jwt_secret_key_prepwiseai_32chars
JWT_EXPIRE=7d

# 3. Groq API Key
# Sign up and create an API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Environment
NODE_ENV=production
PORT=8000
MAX_FILE_SIZE=10485760

